{{!
    Enquiries section for UCA homepage
}}

<section class="uca-enquiries">
    <!-- Partner Logos -->
    <div class="uca-enquiries-logos">

        <div class="uca-enquiries-logo">
            <img
                src="{{config.wwwroot}}/theme/remui/pix/catapult-logo.webp"
                alt="Catapult">
        </div>

        <div class="uca-enquiries-logo">
            <img
                src="{{config.wwwroot}}/theme/remui/pix/adit-logo.webp"
                alt="AITD">
        </div>

        <div class="uca-enquiries-logo">
            <img
                src="{{config.wwwroot}}/theme/remui/pix/job-ready-logo.webp"
                alt="Job Ready">
        </div>

    </div>


    <!-- Enquiries Box -->
    <div class="uca-enquiries-box">

        <div class="uca-enquiries-pattern"></div>

        <div class="uca-enquiries-content">

            <h2>Enquiries</h2>

            <p class="uca-enquiries-description">
                If you have any questions, or a general enquiry, please enter your
                details and one of our friendly staff will contact you shortly.
            </p>


            <div class="uca-enquiries-contact">

                <!-- Email -->
                <div class="uca-enquiries-contact-item">

                    <span class="uca-enquiries-label">
                        Get In Touch:
                    </span>

                    <a href="mailto:contact@ucareer.org.au">
                        contact@ucareer.org.au
                    </a>

                </div>


                <!-- OR -->
                <div class="uca-enquiries-or">
                    <span>or</span>
                </div>


                <!-- Phone -->
                <div class="uca-enquiries-contact-item">

                    <span class="uca-enquiries-label">
                        Call Us On:
                    </span>

                    <a href="tel:136822">
                        13 68 22
                    </a>

                </div>

            </div>


            <!-- Enquire Button -->
            <div class="uca-enquiries-button-wrapper">

                <a href="https://stagewp1.ucareer.org.au/contact-us/"
                   class="uca-enquiries-button">

                    Enquire Now

                    <span class="uca-enquiries-arrow">
                        →
                    </span>

                </a>

            </div>

        </div>

    </div>

</section>