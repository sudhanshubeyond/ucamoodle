{{# slider}}

<section class="hero-section-banner--cc">
    <div class="container">
        <div class="row align-items-end">

            <div class="col-lg-7 hero-text-wrapper-banner--cc">

                <img src="{{config.wwwroot}}/theme/remui/pix/shape-13.png"
                     alt=""
                     class="shape-dots-banner--cc left-banner--cc">

                <h1 class="hero-title-banner--cc">
                   <span class="text-banner--cc"> Personal </span> <br>
                    <span class="highlight-text-banner--cc">empowerment</span> <br>
                    <span class="text-banner--cc">through education</span>
                </h1>

                <p class="hero-subtitle-banner--cc">
                    Click here to register your interest in the Universal College of Australia courses
                </p>

                <a href="#" class="btn-apply-banner--cc">
                    Apply Now
                    <i class="fa-solid fa-arrow-right"></i>
                </a>

            </div>

            <div class="col-lg-5 hero-image-banner--cc-wrapper-banner--cc">

                <div class="cyan-circle-banner--cc"></div>

                <img src="{{config.wwwroot}}/theme/remui/pix/girl-1.png"
                     alt="Happy Student"
                     class="hero-image-banner--cc">

            </div>

        </div>
    </div>
</section>

<section class="feature-bar-banner--cc">
    <div class="container-fluid p-0 custom-size-features-group">

        <div class="row g-0">

            <div class="col-lg-4 col-md-12 feature-item-banner--cc">

                <div class="feature-icon-box-banner--cc">
                    <i class="fa-solid fa-user-tie"></i>
                </div>

                <div class="feature-text-banner--cc">
