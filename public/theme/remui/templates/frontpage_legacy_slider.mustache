                </div>

            </div>

            <div class="col-lg-4 col-md-12 feature-item-banner--cc">

                <div class="feature-icon-box-banner--cc">
                    <i class="fa-solid fa-shield"></i>
                </div>

                <div class="feature-text-banner--cc">
                    Compliance
                </div>

            </div>

            <div class="col-lg-4 col-md-12 feature-item-banner--cc">

                <div class="feature-icon-box-banner--cc">
                    <i class="fa-solid fa-sitemap"></i>
                </div>

                <div class="feature-text-banner--cc">
                    Management <br> System
                </div>

            </div>

        </div>

    </div>
</section>

{{/ slider}}
<script>
        document.addEventListener('mousemove', function (e) {
            const width = window.innerWidth;
            const height = window.innerHeight;

            const mouseX = e.clientX;
            const mouseY = e.clientY;

            const shapeDots = document.querySelector('.shape-dots-banner--cc.left-banner--cc');
            const cyanCircle = document.querySelector('.cyan-circle-banner--cc');

            if (shapeDots) {

                const moveX = (width / 2 - mouseX) * 0.03;
                const moveY = (height / 2 - mouseY) * 0.03;
                shapeDots.style.transform = `translate(${moveX}px, ${moveY}px)`;
            }

            if (cyanCircle) {

                const moveX = (mouseX - width / 2) * 0.05;
                const moveY = (mouseY - height / 2) * 0.05;
                cyanCircle.style.transform = `translate(${moveX}px, ${moveY}px)`;
            }
        });
    </script>