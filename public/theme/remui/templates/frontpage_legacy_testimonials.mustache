                    </div>

                    <div class="uca-testimonial-stars">
                        ★★★★★
                    </div>

                    <div class="uca-testimonial-name">
                        Service Manager
                    </div>

                    <div class="uca-testimonial-company">
                        Mission Australia 2003
                    </div>

                </div>


                <!-- TESTIMONIAL 2 -->
                <div class="uca-testimonial-slide">

                    <div class="uca-testimonial-profile">

                        <img
                            src="{{config.wwwroot}}/theme/remui/pix/testimonial-02.png"
                            alt="Learner"
                            class="uca-testimonial-avatar">

                    </div>

                    <div class="uca-testimonial-text">

                        <p>
                            The training was very useful and practical. The course
                            helped me improve my skills and gave me greater confidence
                            to apply what I learned in the workplace.
                        </p>

                    </div>

                    <div class="uca-testimonial-stars">
                        ★★★★★
                    </div>

                    <div class="uca-testimonial-name">
                        Course Participant
                    </div>

                    <div class="uca-testimonial-company">
                        Universal College of Australia
                    </div>

                </div>


                <!-- TESTIMONIAL 3 -->
                <div class="uca-testimonial-slide">

                    <div class="uca-testimonial-profile">

                        <img
                            src="{{config.wwwroot}}/theme/remui/pix/testimonial-03.png"
                            alt="Learner"
                            class="uca-testimonial-avatar">

                    </div>

                    <div class="uca-testimonial-text">

                        <p>
                            I really enjoyed the learning experience. The trainers
                            explained everything clearly and provided excellent
                            support throughout the course. I would definitely
                            recommend this course to other learners.
                        </p>

                    </div>

                    <div class="uca-testimonial-stars">
                        ★★★★★
                    </div>

                    <div class="uca-testimonial-name">
                        Course Learner
                    </div>

                    <div class="uca-testimonial-company">
                        UCA Student
                    </div>

                </div>

            </div>


            <!-- Navigation -->
            <div class="uca-testimonial-navigation">

                <button
                    type="button"
                    class="uca-testimonial-arrow uca-testimonial-prev">
                    ←
                </button>

                <button
                    type="button"
                    class="uca-testimonial-arrow uca-testimonial-next">
                    →
                </button>

            </div>

        </div>

    </div>

</section>


<script>

document.addEventListener('DOMContentLoaded', function() {

    const section = document.querySelector('.uca-testimonials');

    if (!section) {
        return;
    }

    const slides = section.querySelectorAll(
        '.uca-testimonial-slide'
    );

    const nextButton = section.querySelector(
        '.uca-testimonial-next'
    );

    const prevButton = section.querySelector(
        '.uca-testimonial-prev'
    );

    if (!slides.length) {
        return;
    }

    let current = 0;
    let isAnimating = false;

    const autoSlideTime = 5000;
    const transitionTime = 700;


    /*
     * Set initial positions
     */

    slides.forEach(function(slide, index) {

        slide.style.transition = 'none';

        if (index === 0) {

            slide.classList.add('active');

            slide.style.transform =
                'translateX(0)';

        } else {

            slide.classList.remove('active');

            slide.style.transform =
                'translateX(100%)';

        }

    });


    /*
     * NEXT
     *
     * Current slide:
     * LEFT
     *
     * Next slide:
     * RIGHT -> CENTER
     */

    function nextSlide() {

        if (isAnimating || slides.length < 2) {
            return;
        }

        isAnimating = true;

        const currentSlide = slides[current];

        const nextIndex =
            (current + 1) % slides.length;

        const nextSlide =
            slides[nextIndex];


        /*
         * Put next slide on RIGHT
         */

        nextSlide.style.transition = 'none';

        nextSlide.style.transform =
            'translateX(100%)';

        nextSlide.classList.add('active');


        /*
         * Force browser repaint
         */

        nextSlide.offsetWidth;


        /*
         * Smooth movement
         */

        currentSlide.style.transition =
            'transform 0.7s ease-in-out';

        nextSlide.style.transition =
            'transform 0.7s ease-in-out';


        /*
         * Current -> LEFT
         */

        currentSlide.style.transform =
            'translateX(-100%)';


        /*
         * Next RIGHT -> CENTER
         */

        nextSlide.style.transform =
            'translateX(0)';


        setTimeout(function() {

            currentSlide.classList.remove('active');

            currentSlide.style.transition = 'none';

            currentSlide.style.transform =
                'translateX(100%)';

            current = nextIndex;

            isAnimating = false;

        }, transitionTime);

    }


    /*
     * PREVIOUS
     *
     * Current slide:
     * RIGHT
     *
     * Previous slide:
     * LEFT -> CENTER
     */

    function previousSlide() {

        if (isAnimating || slides.length < 2) {
            return;
        }

        isAnimating = true;

        const currentSlide = slides[current];

        const previousIndex =
            (current - 1 + slides.length) %
            slides.length;

        const previousSlide =
            slides[previousIndex];


        /*
         * Put previous slide on LEFT
         */

        previousSlide.style.transition = 'none';

        previousSlide.style.transform =
            'translateX(-100%)';

        previousSlide.classList.add('active');


        /*
         * Force repaint
         */

        previousSlide.offsetWidth;


        /*
         * Smooth movement
         */

        currentSlide.style.transition =
            'transform 0.7s ease-in-out';

        previousSlide.style.transition =
            'transform 0.7s ease-in-out';


        /*
         * Current -> RIGHT
         */

        currentSlide.style.transform =
            'translateX(100%)';


        /*
         * Previous LEFT -> CENTER
         */

        previousSlide.style.transform =
            'translateX(0)';


        setTimeout(function() {

            currentSlide.classList.remove('active');

            currentSlide.style.transition = 'none';

            currentSlide.style.transform =
                'translateX(100%)';

            current = previousIndex;

            isAnimating = false;

        }, transitionTime);

    }


    /*
     * NEXT BUTTON
     */

    if (nextButton) {

        nextButton.addEventListener(
            'click',
            function() {

                nextSlide();

                restartAutoSlide();

            }
        );

    }


    /*
     * PREVIOUS BUTTON
     */

    if (prevButton) {

        prevButton.addEventListener(
            'click',
            function() {

                previousSlide();

                restartAutoSlide();

            }
        );

    }


    /*
     * AUTO SLIDE
     */

    let autoSlide = setInterval(
        nextSlide,
        autoSlideTime
    );


    /*
     * Restart automatic slider
     * after manual click
     */

    function restartAutoSlide() {

        clearInterval(autoSlide);

        autoSlide = setInterval(
            nextSlide,
            autoSlideTime
        );

    }

});

</script>